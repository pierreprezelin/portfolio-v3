{
	"name": "portfolio-v3",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepare:hooks": "simple-git-hooks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check . --write"
	},
	"simple-git-hooks": {
		"pre-commit": "bunx lint-staged"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/libre-franklin": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"mode-watcher": "^1.1.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@inlang/paraglide-js": "^3.2.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "0.11.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"lint-staged": "16.2.0",
		"mdsvex": "^0.12.8",
		"mdsvex-relative-images": "^2.0.0",
		"sass-embedded": "^1.108.1",
		"shiki": "^4.6.0",
		"simple-git-hooks": "^2.14.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-meta-tags": "^5.0.3",
		"tailwindcss": "^4.3.5",
		"typescript": "6.0.3",
		"vite": "^8.3.6"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
